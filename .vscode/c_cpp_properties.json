{
    "configurations": [
        {
            "name": "Win64 MinGW",
            "compilerPath": "/usr/bin/x86_64-w64-mingw32-g++",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/x86_64-w64-mingw32/include/**",
                "/usr/lib/gcc/x86_64-w64-mingw32/*/include/**",
                "/usr/lib/gcc/x86_64-w64-mingw32/*/include/c++/**"
            ],
            "defines": [
                "UNICODE",
                "_UNICODE",
                "_WIN32",
                "WIN32"
            ],
            "intelliSenseMode": "gcc-x64",
            "cppStandard": "c++20",
            "cStandard": "c17"
        }
    ],
    "version": 4
}